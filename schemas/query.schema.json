{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perq query",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {"oneOf": [{"type": "integer"}, {"type": "string", "minLength": 1}]},
    "terms": {"type": "array", "maxItems": 64, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "metadata": {"type": "object"},
    "filters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["field"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "gt": {"type": "number"}, "gte": {"type": "number"},
          "lt": {"type": "number"}, "lte": {"type": "number"}
        },
        "anyOf": [{"required": ["gt"]}, {"required": ["gte"]}, {"required": ["lt"]}, {"required": ["lte"]}],
        "allOf": [{"not": {"required": ["gt", "gte"]}}, {"not": {"required": ["lt", "lte"]}}]
      }
    }
  },
  "anyOf": [
    {"required": ["terms"], "properties": {"terms": {"minItems": 1}}},
    {"required": ["filters"], "properties": {"filters": {"minItems": 1}}}
  ]
}
